# scripts/panel-terminal — shared panel-terminal resolver (issue #108).
#
# SINGLE SOURCE OF TRUTH for "which terminal hosts the streambeats panel":
# both scripts/streambeats-quick (the launcher) and scripts/streambeats-panel
# (the detached toggle wrapper) source this file and call `settings_terminal`
# inside it, so the precedence contract stays literally identical in both
# entry points.
#
# Contract (mirrors the launcher's S5, issue #90/#92):
#   1. the --terminal=<name> flag passed by the CALLER (not visible here),
#   2. panelTerminal in $XDG_CONFIG_HOME/streambeats/settings.json,
#   3. the builtin order: ghostty first (calibrated keycaps, issue #64),
#      then kitty (native quick-access terminal, kitty 0.42+).
#
# The settings read is the anchored, single-pass, top-level scan (issue
# #92): depth and string-aware, value whitelisted to ghostty|kitty, JSON
# escapes NOT decoded, malformed/foreign/absent silently resolves to the
# builtin order (fail-through by contract, never die).

# settings_terminal: prints the persisted panel terminal ("" when unset).
settings_terminal() {
	cfg=${XDG_CONFIG_HOME:-"$HOME"/.config}
	settings_file=$cfg/streambeats/settings.json
	[ -f "$settings_file" ] || return 0
	awk '
	BEGIN { depth = 0; in_str = 0; esc = 0; key = ""; val = ""; mode = 0; found = "" }
	{
		n = length($0)
		for (i = 1; i <= n; i++) {
			c = substr($0, i, 1)
			if (in_str) {
				if (esc) { esc = 0 }
				else if (c == "\\") { esc = 1 }
				else if (c == "\"") { in_str = 0; mode = 0 }
				else { if (mode == 1) { key = key c } else if (mode == 2) { val = val c } }
				continue
			}
			if (c == "\"") {
				in_str = 1
				if (mode == 0 && depth == 1) { mode = 1 }
				else if (mode != 2 && mode != 4) { mode = 4 }
				continue
			}
			if (c == "{" || c == "[") { depth++; mode = 0; key = ""; val = ""; continue }
			if (c == "}" || c == "]") {
				if (depth == 1 && key == "panelTerminal" && (val == "ghostty" || val == "kitty")) { found = val }
				if (depth > 0) { depth = depth - 1 }
				mode = 0; key = ""; val = ""
				continue
			}
			if (c == ",") {
				if (depth == 1 && key == "panelTerminal" && (val == "ghostty" || val == "kitty")) { found = val }
				mode = 0; key = ""; val = ""
				continue
			}
			if (c == ":") {
				if (depth == 1 && key == "panelTerminal") { mode = 2 }
				else if (mode != 0) { mode = 4 }
				continue
			}
		}
	}
	END { print found }
	' "$settings_file" 2>/dev/null
	return 0
}
