#!/bin/sh
# streambeats-quick — open the streambeats player in a Ghostty side panel.
#
#   streambeats-quick [top|bottom|left|right]   # default: right
#
# Starts a Ghostty instance configured with the matching side preset
# (assets/ghostty/streambeats-<side>.conf) and runs the streambeats player in
# it. On Ghostty 1.3.1 that preset renders as a normal dedicated window (no CLI
# action exists to spawn a quick terminal); see docs/ghostty.md.
#
# See docs/ghostty.md and odd/tasks/streambeats.md (T7 / S3, S7, S8).

set -eu

usage() {
	cat <<'EOF'
Usage: streambeats-quick [--terminal=ghostty|kitty] [top|bottom|left|right]

Open the streambeats player in a floating side panel anchored to a screen
edge (default: right). Each side has its own preset per terminal. On Ghostty
1.3.1 the panel is a normal dedicated window; the quick-terminal keys in the
preset take effect once your Ghostty supports the +toggle-quick-terminal
action. The panel is an independent window, separate from any herdr session.

Options:
  --terminal=<name>   Hosts the panel in the named terminal (ghostty or
                      kitty). Without it the choice resolves in this order:
                      settings.json panelTerminal (the TUI settings screen,
                      issue #90) > builtin order (ghostty first, then kitty).
  -h, --help          Show this help and exit.

Examples:
  streambeats-quick                       # right edge strip
  streambeats-quick bottom                # bottom strip
  streambeats-quick --terminal=kitty right # kitty right edge strip

Kitty panels ride the native quick-access terminal (kitty 0.42+); the KDE
global shortcut toggles it by re-running the same command. See docs/kitty.md.
EOF
}

die() {
	printf 'streambeats-quick: error: %s\n' "$*" >&2
	exit 1
}

# Resolve this script's directory without external tools (no `dirname`), so the
# launcher also works with a minimal PATH.
case $0 in
*/*) script_dir=${0%/*} ;;
*) script_dir=. ;;
esac
script_dir=$(CDPATH='' cd -- "$script_dir" && pwd -P) ||
	die "cannot resolve script directory for $0"
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P) ||
	die "cannot resolve repository root from $script_dir"

# Issue #90 anchor panel-terminal resolution (S5):
#   1. the --terminal=<name> flag,
#   2. panelTerminal in $XDG_CONFIG_HOME/streambeats/settings.json (the
#      anchored, narrow read of the machine-written field; a malformed or
#      absent file falls through),
#   3. the builtin order: ghostty first (calibrated keycaps per issue #64),
#      then kitty (native quick-access terminal, kitty 0.42+).
side=right
wished_terminal=
resolve_only=
for arg in "$@"; do
	case $arg in
	-h | --help)
		usage
		exit 0
		;;
	--resolve-terminal) resolve_only=1 ;;
	top | bottom | left | right) side=$arg ;;
	--terminal=ghostty | --terminal=kitty) wished_terminal=${arg#--terminal=} ;;
	--terminal=*)
		printf 'streambeats-quick: error: unknown terminal "%s" (ghostty and kitty are the supported ones)\n\n' "${arg#--terminal=}" >&2
		usage >&2
		exit 2
		;;
	*)
		printf 'streambeats-quick: error: unknown argument "%s"\n\n' "$arg" >&2
		usage >&2
		exit 2
		;;
	esac
done

# settings_terminal reads the panelTerminal choice the TUI settings screen
# persists (issue #92: review findings R2/R3/R4-001). The read is a
# single-pass, TOP-LEVEL anchored character scan: depth is tracked with
# JSON string awareness, so a "panelTerminal" key nested inside another
# object —pretty-printed or hand-minified— or one embedded in a string
# value can never resolve the panel terminal. JSON escapes are not
# decoded: an escaped lookalike value strictly fails to match (safe). The
# documented fail-through contract is preserved: an unreadable or malformed
# file stays silent (builtin order, never die).
settings_terminal() {
	cfg=${XDG_CONFIG_HOME:-"$HOME"/.config}
	settings_file=$cfg/streambeats/settings.json
	[ -f "$settings_file" ] || return 0
	awk '
		# mode: 0 scan (i.e. next top-level string may be a key), 1 key,
		# 2 value of the matched key, 4 value of a skipped key.
		BEGIN { depth = 0; in_str = 0; esc = 0; key = ""; val = ""; mode = 0; found = "" }
		{
			n = length($0)
			for (i = 1; i <= n; i++) {
				c = substr($0, i, 1)
				if (in_str) {
					if (esc) { esc = 0 }
					else if (c == "\\") { esc = 1 }
					else if (c == "\"") { in_str = 0; mode = 0 }
					else { if (mode == 1) { key = key c } else if (mode == 2) { val = val c } }
					continue
				}
				if (c == "\"") {
					in_str = 1
					if (mode == 0 && depth == 1) { mode = 1 }
					else if (mode != 2 && mode != 4) { mode = 4 }
					continue
				}
				if (c == "{" || c == "[") { depth++; mode = 0; key = ""; val = ""; continue }
				if (c == "}" || c == "]") {
					if (depth == 1 && key == "panelTerminal" && (val == "ghostty" || val == "kitty")) { found = val }
					if (depth > 0) { depth = depth - 1 }
					mode = 0; key = ""; val = ""
					continue
				}
				if (c == ",") {
					if (depth == 1 && key == "panelTerminal" && (val == "ghostty" || val == "kitty")) { found = val }
					mode = 0; key = ""; val = ""
					continue
				}
				if (c == ":") {
					if (depth == 1 && key == "panelTerminal") { mode = 2 }
					else if (mode != 0) { mode = 4 }
					continue
				}
			}
		}
		END { print found }
	' "$settings_file" 2>/dev/null
	return 0
}

# Resolution with explicit smoke: a flag or settings value must exist on
# PATH (a wish is validated, never substituted); the remaining case rides
# the builtin order ghostty -> kitty.
wished_terminal=${wished_terminal:-$(settings_terminal)}
if [ -n "$wished_terminal" ]; then
	if ! command -v "$wished_terminal" >/dev/null 2>&1; then
		die "requested terminal '$wished_terminal' is not on PATH"
	fi
	chosen_terminal=$wished_terminal
elif command -v ghostty >/dev/null 2>&1; then
	chosen_terminal=ghostty
elif command -v kitty >/dev/null 2>&1; then
	chosen_terminal=kitty
else
	die "neither ghostty nor kitty found on PATH. Install Ghostty (https://ghostty.org/docs/install) or kitty (https://sw.kovidgoyal.net/kitty/)"
fi

# streambeats-panel's kitty relay (issue #108 S2) asks the launcher for
# the SAME resolution contract without spawning anything: print the chosen
# terminal and exit before any spawn machinery. Zero side effects.
if [ -n "$resolve_only" ]; then
	echo "$chosen_terminal"
	exit 0
fi

kitty_preset=$repo_root/assets/kitty/streambeats-$side.conf
ghostty_preset=$repo_root/assets/ghostty/streambeats-$side.conf
if [ "$chosen_terminal" = ghostty ] && [ ! -f "$ghostty_preset" ]; then
	die "missing preset file: $ghostty_preset"
fi
if [ "$chosen_terminal" = kitty ] && [ ! -f "$kitty_preset" ]; then
	die "missing preset file: $kitty_preset"
fi
preset=$ghostty_preset
[ "$chosen_terminal" = kitty ] && preset=$kitty_preset

# Prefer the repo-built binary; fall back to a `streambeats` already on PATH.
# A stale binary would silently run last week's player, so if `go` is on PATH
# and any .go file is newer than the binary (or the binary is missing),
# rebuild it first.
player_bin=$repo_root/bin/streambeats
if command -v go >/dev/null 2>&1 && { [ ! -x "$player_bin" ] || [ -n "$(find "$repo_root" -name '*.go' -newer "$player_bin" -print -quit 2>/dev/null)" ]; }; then
	printf 'streambeats-quick: rebuilding the player (sources newer than bin)\n' >&2
	(cd "$repo_root" && go build -o bin/streambeats ./cmd/streambeats) ||
		die "rebuild failed; fix the build error or run it yourself: go build -o bin/streambeats ./cmd/streambeats"
fi
if [ -x "$player_bin" ]; then
	:
elif player_bin=$(command -v streambeats 2>/dev/null); then
	:
else
	die "streambeats binary not found. Build it with 'go build -o bin/streambeats ./cmd/streambeats' or install it on PATH."
fi

if [ "$chosen_terminal" = kitty ]; then
	printf 'streambeats-quick: terminal=%s side=%s preset=%s player=%s\n' "$chosen_terminal" "$side" "$preset" "$player_bin" >&2
	# Issue #90: kitty hosts the panel through its native Quake-style quick
	# access terminal (kitty 0.42+, wlr-layer-shell — the same Wayland
	# requirement as Ghostty). Running this command again toggles the panel
	# per instance-group, so a KDE global shortcut bound to streambeats-quick
	# doubles as the show/hide key.
	kitten_bin=$(command -v kitten 2>/dev/null || true)
	[ -n "$kitten_bin" ] || die "kitten not found on PATH (kitten ships with kitty)"
	printf '%s\n' \
		'streambeats-quick: note: the kitty panel rides the native quick access' \
		'  terminal; run streambeats-quick again (or the KDE global shortcut it' \
		'  is bound to) to toggle it. See docs/kitty.md.' >&2
	exec "$kitten_bin" quick-access-terminal --config "$preset" "$player_bin"
fi

# --- ghostty branch ----------------------------------------------------------
ghostty_bin=$(command -v ghostty 2>/dev/null || true)
[ -n "$ghostty_bin" ] || die "ghostty not found on PATH. Install Ghostty (https://ghostty.org/docs/install) or add its binary to PATH, then re-run $0."

# Summary byte-identical with the pre-#90 launcher (review findings R2/R4,
# lineage review-98c9795b52254860): the ghostty path's stderr keeps both the
# plain summary line and TWO printfs of the 1.3.1 notes (one here, one
# before the exec). The doubled notes were main's behavior — parity wins
# over de-duplication this cycle.
printf 'streambeats-quick: side=%s preset=%s player=%s\n' "$side" "$preset" "$player_bin" >&2
printf '%s\n' \
	'streambeats-quick: note: Ghostty 1.3.1 cannot spawn a quick terminal from the CLI' \
	'  (the +toggle-quick-terminal action landed after that release), so this panel' \
	'  opens as a normal dedicated window. Auto-opening the quick terminal needs a' \
	'  newer Ghostty build; the side presets already configure position, size and' \
	'  autohide for it.' \
	'streambeats-quick: note: inside the panel, ctrl+alt+s toggles the Ghostty quick' \
	'  terminal once your binary supports that action.' >&2

# Virtual XDG config home so Ghostty loads the preset through its canonical
# config path. `--config=<path>` is NOT a real Ghostty option (see
# ghostty discussions #9434/#10058): passing it makes the GTK runtime report
# `config: unknown field` for a pseudo-config built from the CLI arguments.
#
# Round-7 (issue #57 follow-up): the panel runs PRESET-ONLY — the user's
# personal ghostty config is deliberately NOT merged. Evidence: with the
# user config merged, the owner's custom GLSL shader rescales the rendered
# surface and ghostty's mouse pixel→cell mapping drifts linearly with the
# row (clicks at painted rows 42/20/5 reported 3/19/5 on their install),
# so every transport click landed on a different list row. The clean,
# preset-only config was verified pixel-perfect on the same machine. The
# panel is a utility window: fixed look, fixed behavior.
confdir=$(mktemp -d "${TMPDIR:-/tmp}/streambeats-ghostty.XXXXXX") ||
		die "cannot create temp config dir"
mkdir "$confdir/ghostty"
cp "$preset" "$confdir/ghostty/config"

# Issue #80: the virtual XDG above is for Ghostty's preset resolution only —
# the player child must see the USER's real config home, or it cannot read
# their settings.json or user-dirs.dirs (library root fell back to ~/Music).
user_xdg=${XDG_CONFIG_HOME:-}

printf 'streambeats-quick: side=%s preset=%s player=%s\n' "$side" "$preset" "$player_bin" >&2
printf '%s\n' \
	'streambeats-quick: note: Ghostty 1.3.1 cannot spawn a quick terminal from the CLI' \
	'  (the +toggle-quick-terminal action landed after that release), so this panel' \
	'  opens as a normal dedicated window. Auto-opening the quick terminal needs a' \
	'  newer Ghostty build; the side presets already configure position, size and' \
	'  autohide for it.' \
	'streambeats-quick: note: inside the panel, ctrl+alt+s toggles the Ghostty quick' \
	'  terminal once your binary supports that action.' \
	'streambeats-quick: note: temp config kept at' "$confdir" >&2

if [ -n "$user_xdg" ]; then
	# The user runs with a custom XDG_CONFIG_HOME: the child keeps THEIR value.
	exec env XDG_CONFIG_HOME="$confdir" "$ghostty_bin" \
		--gtk-single-instance=false \
		-e env "XDG_CONFIG_HOME=$user_xdg" "$player_bin"
fi
exec env XDG_CONFIG_HOME="$confdir" "$ghostty_bin" \
	--gtk-single-instance=false \
	-e env -u XDG_CONFIG_HOME "$player_bin"
