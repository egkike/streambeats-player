[Desktop Entry]
Type=Application
Version=1.0
Name=streambeats panel
GenericName=Floating StreamBeats player
Comment=Open the floating StreamBeats side panel (ghostty + mpv)
# Generated by scripts/install.sh: @PREFIX@ is the install prefix so the
# Exec/Icon never depend on PATH resolution.
Exec=@PREFIX@/bin/streambeats-panel toggle right
TryExec=@PREFIX@/bin/streambeats-panel
Icon=@PREFIX@/share/icons/hicolor/scalable/apps/streambeats-panel.svg
Terminal=false
NoDisplay=false
Actions=top;bottom;left;right;
Categories=AudioVideo;Audio;Music;
Keywords=music;player;streambeats;ghostty;panel;
StartupWMClass=streambeats-panel

[Desktop Action top]
Name=streambeats panel — top
Exec=@PREFIX@/bin/streambeats-panel toggle top
Icon=@PREFIX@/share/icons/hicolor/scalable/apps/streambeats-panel.svg

[Desktop Action bottom]
Name=streambeats panel — bottom
Exec=@PREFIX@/bin/streambeats-panel toggle bottom
Icon=@PREFIX@/share/icons/hicolor/scalable/apps/streambeats-panel.svg

[Desktop Action left]
Name=streambeats panel — left
Exec=@PREFIX@/bin/streambeats-panel toggle left
Icon=@PREFIX@/share/icons/hicolor/scalable/apps/streambeats-panel.svg

[Desktop Action right]
Name=streambeats panel — right
Exec=@PREFIX@/bin/streambeats-panel toggle right
Icon=@PREFIX@/share/icons/hicolor/scalable/apps/streambeats-panel.svg
